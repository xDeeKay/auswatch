generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CameraType {
  alpr
  facial
  cctv
  speed
  other
}

enum CaptureType {
  plates
  faces
  both
  general
  unclear
}

enum CameraStatus {
  active
  removed
  unconfirmed
}

enum ModerationState {
  pending
  verified
  disputed
  removed
}

enum HistoryEventType {
  sighted
  active
  removed
  unconfirmed
  relocated
  corrected
}

enum SensitiveZoneCategory {
  dv_shelter
  school
  military
  correctional
  embassy
  private_residence
  security_detail
  other
}

enum SensitiveSiteMatchSource {
  manual_zone
  osm_overpass
  check_error
}

enum ModerationActionType {
  verify
  remove
  correction_approve
  correction_reject
}

enum CorrectionReportStatus {
  pending
  approved
  rejected
}

enum ModerationReasonCode {
  verified_accurate
  duplicate
  sensitive_site
  defamation_risk
  implausible
  out_of_scope
  other
}

enum AuState {
  nsw
  vic
  qld
  wa
  sa
  tas
  act
  nt
}

enum ModeratorRole {
  moderator
  admin
}

model Camera {
  id                   String               @id @default(cuid())
  lat                  Float
  lng                  Float
  type                 CameraType
  operator             String
  captures             CaptureType
  status               CameraStatus         @default(unconfirmed)
  notes                String               @default("")
  reporterId           String // anonymized token only, never PII (IP, email, account)
  moderationState      ModerationState      @default(pending)
  state                AuState?
  stateOverride        Boolean              @default(false)
  createdAt            DateTime             @default(now())
  history              HistoryEvent[]
  sensitiveSiteMatches SensitiveSiteMatch[]
  moderationActions    ModerationAction[]
  correctionReports    CorrectionReport[]
  internalNotes        CameraNote[]

  @@index([status])
  @@index([moderationState])
  @@index([type])
  @@index([reporterId, createdAt])
  @@index([state])
}

model HistoryEvent {
  id        String           @id @default(cuid())
  camera    Camera           @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  cameraId  String
  date      DateTime
  eventType HistoryEventType
  note      String           @default("")

  @@index([cameraId])
}

model SensitiveZone {
  id           String                @id @default(cuid())
  category     SensitiveZoneCategory
  lat          Float
  lng          Float
  radiusMeters Int
  note         String                @default("")
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  matches      SensitiveSiteMatch[]

  @@index([category])
  @@index([active])
}

model SensitiveSiteMatch {
  id             String                   @id @default(cuid())
  camera         Camera                   @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  cameraId       String
  source         SensitiveSiteMatchSource
  category       SensitiveZoneCategory?
  zone           SensitiveZone?           @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  zoneId         String?
  distanceMeters Float?
  detail         String                   @default("")
  createdAt      DateTime                 @default(now())

  @@index([cameraId])
  @@index([source])
}

model CorrectionReport {
  id         String                 @id @default(cuid())
  camera     Camera                 @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  cameraId   String
  reporterId String
  status     CorrectionReportStatus @default(pending)

  proposedLat      Float?
  proposedLng      Float?
  proposedType     CameraType?
  proposedOperator String?
  proposedCaptures CaptureType?
  proposedNotes    String?

  reporterNote String    @default("")
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?

  proposedSensitiveSiteMatches     Json?
  proposedSensitiveSiteCheckErrors Json?

  moderationActions ModerationAction[]

  @@index([cameraId, status])
  @@index([reporterId, createdAt])
}

model CameraNote {
  id        String   @id @default(cuid())
  camera    Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  cameraId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId  String
  body      String
  createdAt DateTime @default(now())

  @@index([cameraId, createdAt])
}

model ReporterIdentity {
  id           String   @id @default(cuid())
  token        String   @unique
  signalHash   String
  lastIssuedAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([signalHash])
}

model User {
  id                      String             @id @default(cuid())
  name                    String?
  email                   String?            @unique
  emailVerified           DateTime?
  image                   String?
  createdAt               DateTime           @default(now())
  accounts                Account[]
  sessions                Session[]
  moderationActions       ModerationAction[]
  cameraNotes             CameraNote[]
  moderatorProfile        ModeratorProfile?
  moderatorProfilesEdited ModeratorProfile[] @relation("ModeratorProfileEditedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ModerationAction {
  id                 String               @id @default(cuid())
  camera             Camera               @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  cameraId           String
  actor              User                 @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorId            String
  action             ModerationActionType
  reasonCode         ModerationReasonCode
  note               String               @default("")
  createdAt          DateTime             @default(now())
  correctionReport   CorrectionReport?    @relation(fields: [correctionReportId], references: [id], onDelete: SetNull)
  correctionReportId String?

  @@index([cameraId])
  @@index([actorId])
  @@index([correctionReportId])
}

model ModeratorProfile {
  id                 String           @id @default(cuid())
  email              String           @unique
  userId             String?          @unique
  user               User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  role               ModeratorRole    @default(moderator)
  grants             ModeratorGrant[]
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deactivatedAt      DateTime?
  lastEditedByUserId String?
  lastEditedBy       User?            @relation("ModeratorProfileEditedBy", fields: [lastEditedByUserId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([role])
}

model ModeratorGrant {
  id                 String           @id @default(cuid())
  moderatorProfile   ModeratorProfile @relation(fields: [moderatorProfileId], references: [id], onDelete: Cascade)
  moderatorProfileId String
  state              AuState
  cameraType         CameraType
  canView            Boolean          @default(true)
  canAct             Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([moderatorProfileId, state, cameraType])
  @@index([moderatorProfileId])
}
