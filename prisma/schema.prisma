generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CameraType {
  alpr
  facial
  cctv
  speed
  other
}

enum CaptureType {
  plates
  faces
  both
  general
  unclear
}

enum CameraStatus {
  active
  removed
  unconfirmed
}

enum ModerationState {
  pending
  verified
  disputed
  removed
}

enum HistoryEventType {
  sighted
  active
  removed
  unconfirmed
  relocated
  corrected
}

enum SensitiveZoneCategory {
  dv_shelter
  school
  military
  correctional
  embassy
  private_residence
  security_detail
  other
}

enum SensitiveSiteMatchSource {
  manual_zone
  osm_overpass
  check_error
}

enum ModerationActionType {
  verify
  remove
  correction_approve
  correction_reject
}

enum CorrectionReportStatus {
  pending
  approved
  rejected
}

enum ModerationReasonCode {
  verified_accurate
  official_dataset
  public_imagery
  corroborating_reports
  moderator_observation
  duplicate
  sensitive_site
  defamation_risk
  implausible
  out_of_scope
  spam_or_low_quality
  other
}

enum AuState {
  nsw
  vic
  qld
  wa
  sa
  tas
  act
  nt
}

enum OperatorCategory {
  state_police
  local_council
  transport_authority
  private
  unknown
}

enum ExternalImportSource {
  act_open_data
  vic_open_data
  nsw_open_data
  qld_open_data
}

enum ModeratorRole {
  moderator
  admin
}

enum AuditEntityType {
  camera
  correction_report
  camera_note
  moderator_profile
}

enum AuditActionType {
  camera_verify
  camera_remove
  camera_correction_approve
  camera_correction_reject
  camera_state_override
  camera_note_add
  moderator_create
  moderator_update
  moderator_deactivate
  moderator_reactivate
}

enum PhotoModerationStatus {
  pending
  approved
  rejected
}

model Camera {
  id                   String               @id @default(cuid())
  lat                  Float
  lng                  Float
  type                 CameraType
  operator             String               @default("")
  operatorCategory     OperatorCategory     @default(unknown)
  captures             CaptureType
  status               CameraStatus         @default(unconfirmed)
  notes                String               @default("")
  reporterId           String // anonymized token only, never PII (IP, email, account)
  moderationState      ModerationState      @default(pending)
  state                AuState?
  stateOverride        Boolean              @default(false)
  externalSource       ExternalImportSource?
  externalRef          String?
  createdAt            DateTime             @default(now())
  history              HistoryEvent[]
  sensitiveSiteMatches SensitiveSiteMatch[]
  moderationActions    ModerationAction[]
  correctionReports    CorrectionReport[]
  internalNotes        CameraNote[]
  photos               CameraPhoto[]

  @@unique([externalSource, externalRef])
  @@index([status])
  @@index([moderationState])
  @@index([type])
  @@index([reporterId, createdAt])
  @@index([state])
}

model HistoryEvent {
  id        String           @id @default(cuid())
  camera    Camera           @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  cameraId  String
  date      DateTime
  eventType HistoryEventType
  note      String           @default("")

  @@index([cameraId])
}

model SensitiveZone {
  id           String                @id @default(cuid())
  category     SensitiveZoneCategory
  lat          Float
  lng          Float
  radiusMeters Int
  note         String                @default("")
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  matches      SensitiveSiteMatch[]

  @@index([category])
  @@index([active])
}

model SensitiveSiteOsmCache {
  id          String                @id @default(cuid())
  category    SensitiveZoneCategory
  lat         Float
  lng         Float
  detail      String
  refreshedAt DateTime

  @@index([lat, lng])
  @@index([refreshedAt])
}

model SensitiveSiteMatch {
  id             String                   @id @default(cuid())
  camera         Camera                   @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  cameraId       String
  source         SensitiveSiteMatchSource
  category       SensitiveZoneCategory?
  zone           SensitiveZone?           @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  zoneId         String?
  distanceMeters Float?
  lat            Float?
  lng            Float?
  detail         String                   @default("")
  createdAt      DateTime                 @default(now())

  @@index([cameraId])
  @@index([source])
}

model CorrectionReport {
  id         String                 @id @default(cuid())
  camera     Camera                 @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  cameraId   String
  reporterId String
  status     CorrectionReportStatus @default(pending)

  proposedLat              Float?
  proposedLng              Float?
  proposedType             CameraType?
  proposedOperator         String?
  proposedOperatorCategory OperatorCategory?
  proposedCaptures         CaptureType?
  proposedNotes            String?
  // A separate claim, not a mirrored full-state field like the proposed*
  // columns above: "this camera is no longer there," independent of whether
  // any other field also changed.
  reportedRemoved          Boolean            @default(false)

  reporterNote String    @default("")
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?

  proposedSensitiveSiteMatches     Json?
  proposedSensitiveSiteCheckErrors Json?

  moderationActions ModerationAction[]
  photos            CorrectionPhoto[]

  @@index([cameraId, status])
  @@index([reporterId, createdAt])
}

model CameraPhoto {
  id       String @id @default(cuid())
  camera   Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  cameraId String

  storageKey  String
  contentType String
  sizeBytes   Int
  width       Int
  height      Int

  // Derived-only signals computed from the photo's EXIF at upload time; the
  // raw GPS coordinate and capture timestamp are never stored (see
  // src/lib/photo-processing.ts), only how far/how stale they imply the
  // photo is relative to the submission itself.
  gpsDistanceMeters Float?
  capturedAgeHours  Float?

  // Never public until a moderator explicitly approves it, independent of
  // the camera's own moderationState - see the "Decision" section on the
  // ticket detail page, where this is decided alongside verifying the camera.
  moderationStatus PhotoModerationStatus @default(pending)
  createdAt        DateTime              @default(now())

  @@index([cameraId])
}

model CorrectionPhoto {
  id                 String           @id @default(cuid())
  correctionReport   CorrectionReport @relation(fields: [correctionReportId], references: [id], onDelete: Cascade)
  correctionReportId String

  storageKey  String
  contentType String
  sizeBytes   Int
  width       Int
  height      Int

  gpsDistanceMeters Float?
  capturedAgeHours  Float?
  createdAt         DateTime @default(now())

  @@index([correctionReportId])
}

model CameraNote {
  id        String    @id @default(cuid())
  camera    Camera    @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  cameraId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([cameraId, createdAt])
}

model ReporterIdentity {
  id           String   @id @default(cuid())
  token        String   @unique
  signalHash   String
  lastIssuedAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([signalHash])
}

model User {
  id                      String             @id @default(cuid())
  name                    String?
  email                   String?            @unique
  emailVerified           DateTime?
  image                   String?
  createdAt               DateTime           @default(now())
  accounts                Account[]
  sessions                Session[]
  moderationActions       ModerationAction[]
  cameraNotes             CameraNote[]
  moderatorProfile        ModeratorProfile?
  moderatorProfilesEdited ModeratorProfile[] @relation("ModeratorProfileEditedBy")
  auditLogEntries         AuditLogEntry[]    @relation("AuditLogActor")
  auditLogEntriesReverted AuditLogEntry[]    @relation("AuditLogRevertedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ModerationAction {
  id                 String               @id @default(cuid())
  camera             Camera               @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  cameraId           String
  actor              User                 @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorId            String
  action             ModerationActionType
  reasonCode         ModerationReasonCode
  note               String               @default("")
  createdAt          DateTime             @default(now())
  correctionReport   CorrectionReport?    @relation(fields: [correctionReportId], references: [id], onDelete: SetNull)
  correctionReportId String?
  auditLogEntry      AuditLogEntry?

  @@index([cameraId])
  @@index([actorId])
  @@index([correctionReportId])
}

model ModeratorProfile {
  id                 String           @id @default(cuid())
  email              String           @unique
  userId             String?          @unique
  user               User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  role               ModeratorRole    @default(moderator)
  grants             ModeratorGrant[]
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deactivatedAt      DateTime?
  lastEditedByUserId String?
  lastEditedBy       User?            @relation("ModeratorProfileEditedBy", fields: [lastEditedByUserId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([role])
}

model ModeratorGrant {
  id                 String           @id @default(cuid())
  moderatorProfile   ModeratorProfile @relation(fields: [moderatorProfileId], references: [id], onDelete: Cascade)
  moderatorProfileId String
  state              AuState
  cameraType         CameraType
  canView            Boolean          @default(true)
  canAct             Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([moderatorProfileId, state, cameraType])
  @@index([moderatorProfileId])
}

model AuditLogEntry {
  id         String          @id @default(cuid())
  entityType AuditEntityType
  entityId   String
  action     AuditActionType
  actor      User            @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorId    String
  before     Json?
  after      Json?
  summary    String          @default("")
  createdAt  DateTime        @default(now())

  moderationAction   ModerationAction? @relation(fields: [moderationActionId], references: [id], onDelete: SetNull)
  moderationActionId String?           @unique

  revertsEntry    AuditLogEntry? @relation("AuditLogRevert", fields: [revertsEntryId], references: [id], onDelete: SetNull)
  revertsEntryId  String?        @unique
  revertedByEntry AuditLogEntry? @relation("AuditLogRevert")

  revertedAt       DateTime?
  revertedByUserId String?
  revertedBy       User?     @relation("AuditLogRevertedBy", fields: [revertedByUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId])
  @@index([revertedAt])
}
