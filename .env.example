DATABASE_URL="postgresql://user:password@localhost:5432/auswatch"

# Server-only pepper for hashing the rate-limit identity signal. Never a real
# value in this file: generate one per environment and set it in the actual
# .env / server secrets, never commit it.
REPORTER_SIGNAL_SECRET=
REPORTER_IDENTITY_ISSUANCE_COOLDOWN_MINUTES=
SUBMISSION_RATE_LIMIT_WINDOW_MINUTES=
SUBMISSION_RATE_LIMIT_MAX_PER_SIGNAL_WINDOW=
SUBMISSION_RATE_LIMIT_MAX_GLOBAL_PER_WINDOW=
SUBMISSION_VELOCITY_ALERT_THRESHOLD_PER_WINDOW=
OSM_SENSITIVE_SITE_CHECK_RADIUS_METERS=
OVERPASS_TIMEOUT_MS=
CORRECTION_RATE_LIMIT_WINDOW_MINUTES=
CORRECTION_RATE_LIMIT_MAX_PER_SIGNAL_WINDOW=
CORRECTION_RATE_LIMIT_MAX_GLOBAL_PER_WINDOW=
CORRECTION_VELOCITY_ALERT_THRESHOLD_PER_WINDOW=
CORRECTION_MAX_PENDING_PER_CAMERA=

# Moderator authentication (NextAuth / GitHub OAuth). Register a GitHub OAuth
# App for the real ID/secret. AUTH_SECRET: generate with `openssl rand -base64 32`.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Comma-separated list of GitHub-account emails allowed to sign in as a
# moderator. Never a real value in this file.
MODERATOR_EMAILS=
